import json
import logging
from collections import defaultdict
from kafka import KafkaConsumer
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.cluster import DBSCAN

logger = logging.getLogger("failure_analyzer")

class FailureClustering:
    def __init__(self, bootstrap_servers, dlq_topic='hunter_dlq'):
        self.consumer = KafkaConsumer(dlq_topic, bootstrap_servers=bootstrap_servers,
                                      value_deserializer=lambda m: json.loads(m.decode('utf-8')))
        self.error_buffer = []

    def _vectorize(self, messages):
        vectorizer = TfidfVectorizer(max_features=100)
        texts = [json.dumps(msg) for msg in messages]
        return vectorizer.fit_transform(texts).toarray()

    def analyze(self):
        for msg in self.consumer:
            self.error_buffer.append(msg.value)
            if len(self.error_buffer) >= 50:
                vectors = self._vectorize(self.error_buffer)
                clusters = DBSCAN(eps=0.5, min_samples=3).fit(vectors)
                labels = clusters.labels_
                grouped = defaultdict(list)
                for i, label in enumerate(labels):
                    grouped[label].append(self.error_buffer[i])
                for label, msgs in grouped.items():
                    sample = msgs[0]
                    logger.warning(f"Cluster {label}: {len(msgs)} failures, sample={sample.get('error', 'unknown')}")
                self.error_buffer.clear()
