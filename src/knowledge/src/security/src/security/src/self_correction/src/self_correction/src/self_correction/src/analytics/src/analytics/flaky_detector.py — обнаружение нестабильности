import numpy as np
from collections import deque
from prometheus_client import Gauge

flaky_score = Gauge('agent_flaky_score', 'Flaky behavior score (0-100)', ['agent_id'])

class FlakyDetector:
    def __init__(self, window_size=20):
        self.win_rates = deque(maxlen=window_size)
        self.pnl_values = deque(maxlen=window_size)

    def update(self, win_rate: float, pnl: float):
        self.win_rates.append(win_rate)
        self.pnl_values.append(pnl)

    def get_flaky_score(self) -> float:
        if len(self.win_rates) < 10:
            return 0.0
        wr_std = np.std(self.win_rates)
        pnl_std = np.std(self.pnl_values)
        score = (wr_std * 200 + pnl_std / 1000) * 100
        return min(100.0, max(0.0, score))

    def mark_flaky(self, agent_id: str):
        score = self.get_flaky_score()
        flaky_score.labels(agent_id=agent_id).set(score)
        return score > 50
