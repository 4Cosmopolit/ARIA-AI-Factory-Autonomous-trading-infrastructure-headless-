import json
import hashlib
from typing import Optional

class OdabNote:
    def __init__(self, storage_path: str = "data/error_patterns.json"):
        self.storage_path = storage_path
        self.patterns: dict = self._load()

    def _load(self) -> dict:
        try:
            with open(self.storage_path, 'r') as f:
                return json.load(f)
        except:
            return {}

    def _save(self):
        with open(self.storage_path, 'w') as f:
            json.dump(self.patterns, f, indent=2)

    def record_error(self, error_type: str, context: dict, solution: str):
        key = hashlib.md5(json.dumps(context, sort_keys=True).encode()).hexdigest()[:12]
        self.patterns[key] = {
            "error_type": error_type,
            "context": context,
            "solution": solution,
            "count": self.patterns.get(key, {}).get("count", 0) + 1
        }
        self._save()

    def find_solution(self, error_type: str, context: dict) -> Optional[str]:
        key = hashlib.md5(json.dumps(context, sort_keys=True).encode()).hexdigest()[:12]
        if key in self.patterns and self.patterns[key]["count"] >= 2:
            return self.patterns[key]["solution"]
        for pattern in self.patterns.values():
            if pattern["error_type"] == error_type and pattern["count"] >= 3:
                return pattern["solution"]
        return None
