import os
import requests
import json
from typing import Optional

class NvidiaNIMClient:
    def __init__(self, api_key: Optional[str] = None):
        self.api_key = api_key or os.getenv("NVIDIA_NIM_API_KEY")
        if not self.api_key:
            raise ValueError("NVIDIA_NIM_API_KEY environment variable is not set")
        self.base_url = "https://api.nvidia.com/v1"
        self.model = "meta/llama-3.1-nemotron-ultra-253b-v1"

    def generate(self, prompt: str, max_tokens: int = 500, temperature: float = 0.7) -> str:
        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Content-Type": "application/json"
        }
        payload = {
            "model": self.model,
            "messages": [{"role": "user", "content": prompt}],
            "max_tokens": max_tokens,
            "temperature": temperature
        }
        try:
            response = requests.post(f"{self.base_url}/chat/completions", headers=headers, json=payload)
            if response.status_code == 200:
                return response.json()["choices"][0]["message"]["content"]
            else:
                print(f"NIM API error: {response.status_code} - {response.text}")
                return ""
        except Exception as e:
            print(f"NIM request failed: {e}")
            return ""

class NewsAnalyzer:
    def __init__(self, nim_client: NvidiaNIMClient):
        self.nim = nim_client

    def analyze_market_context(self, signal: dict) -> str:
        prompt = f"""You are an expert options trader. Analyze the following market signal and decide whether to enter a trade.

Signal details:
- Type: {signal.get('type')}
- Skew Value: {signal.get('skew_value')}
- Expiry: {signal.get('expiry')}
- Current Price: {signal.get('current_price')}
- Put Strike: {signal.get('put_strike')}
- Call Strike: {signal.get('call_strike')}

Your task:
1. Assess the overall market sentiment based on the volatility skew.
2. Determine if this is a good opportunity to enter a Long Strangle.
3. Return ONLY one word: "YES" if you recommend entering the trade, or "NO" if you recommend skipping it.

Decision:"""
        
        response = self.nim.generate(prompt, max_tokens=10, temperature=0.3)
        return response.strip().upper()

    def analyze_with_context(self, signal: dict, context: str) -> str:
        prompt = f"""You are an expert options trader. Analyze the following signal with full portfolio context.

Market Signal:
- Type: {signal.get('type')}
- Skew: {signal.get('skew_value')}
- Expiry: {signal.get('expiry')}

{context}

Based on this information, return "YES" to enter the trade or "NO" to skip it.
Decision:"""
        
        response = self.nim.generate(prompt, max_tokens=10, temperature=0.3)
        return response.strip().upper()
