# ARIA AI‑Factory Environment v13.01
# Все значения замените на реальные ключи доступа.

# ========== Торговля (Bybit Options) ==========
BYBIT_API_KEY=your_testnet_api_key
BYBIT_API_SECRET=your_testnet_api_secret
TESTNET=true
POSITION_SIZE_USDT=1000
TAKE_PROFIT_PCT=50
STOP_LOSS_PCT=30
DELTA_THRESHOLD=0.1

# ========== Kafka ==========
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ========== Nvidia NIM (опционально) ==========
NVIDIA_NIM_API_KEY=your_nim_api_key_here

# ========== Core ==========
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ========== Финансовые данные ==========
ALPHA_VANTAGE_API_KEY=your_alphavantage_key
BINANCE_API_KEY=your_binance_key
BINANCE_SECRET=your_binance_secret

# ========== Ончейн-разведка ==========
ARKHAM_API_KEY=your_arkham_key
GLASSNODE_API_KEY=your_glassnode_key

# ========== Социальные данные ==========
LUNARCRUSH_API_KEY=your_lunarcrush_key
CRYPTOPANIC_API_KEY=your_cryptopanic_key

# ========== Веб-разведка ==========
NOTTE_API_KEY=your_notte_key
BRIGHTDATA_API_KEY=your_brightdata_key

# ========== Наблюдаемость ==========
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your_grafana_key
PROMETHEUS_URL=http://localhost:9090

# ========== Базы данных ==========
POSTGRES_URL=postgresql://user:pass@localhost:5432/aria
SUPABASE_ACCESS_TOKEN=your_supabase_token

# ========== AI-провайдеры ==========
OPENROUTER_API_KEY=your_openrouter_key
PERPLEXITY_API_KEY=your_perplexity_key

# ========== Threat Intelligence ==========
VIRUSTOTAL_API_KEY=your_virustotal_key
OTX_API_KEY=your_otx_key
ABUSEIPDB_API_KEY=your_abuseipdb_key
IPINFO_TOKEN=your_ipinfo_token
SYCEK_API_KEY=your_sycek_key

# ========== Безопасность (EDR) ==========
FALCON_CLIENT_ID=your_falcon_id
FALCON_CLIENT_SECRET=your_falcon_secret

# ========== Google Workspace ==========
GOOGLE_CLIENT_EMAIL=your_google_email
GOOGLE_PRIVATE_KEY=your_google_private_key

# ========== Почта ==========
IMAP_HOST=imap.example.com
IMAP_USER=user@example.com
IMAP_PASS=password
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASS=password

# ========== Прокси (опционально) ==========
PROXY_LIST=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
PROXY_ROTATION_INTERVAL=300
