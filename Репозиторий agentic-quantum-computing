    timeframe: "1h"
    lookback: 30

encoder:
  kind: "pca"
  latent_dim: 8
  standardize: true

quantum:
  backend: "lightning.gpu"  # или lightning.qubit для CPU
  n_qubits: 8
  feature_map: "dense"      # dense / dense_no_ent / angle / iqp
  reps: 2
  scorer: "qsvm"
  nu: 0.1

baselines:
  - "rbf_ocsvm"
  - "isolation_forest"
  - "ae_recon"
