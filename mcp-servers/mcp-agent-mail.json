{
  "mcpServers": {
    "mcp-agent-mail": {
      "command": "uvx",
      "args": ["mcp-agent-mail"],
      "env": {
        "IMAP_HOST": "${IMAP_HOST}",
        "IMAP_USER": "${IMAP_USER}",
        "IMAP_PASS": "${IMAP_PASS}",
        "SMTP_HOST": "${SMTP_HOST}",
        "SMTP_USER": "${SMTP_USER}",
        "SMTP_PASS": "${SMTP_PASS}"
      }
    }
  }
}
